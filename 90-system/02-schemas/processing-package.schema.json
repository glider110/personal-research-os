{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-research-os:processing-package:1.0",
  "title": "Research processing package",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "topic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "scope"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tool",
        "model",
        "prompt_version",
        "method"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_class": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "ai_generated",
              "user_authored"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "pdf",
              "md",
              "txt",
              "image",
              "url",
              "excel",
              "csv",
              "word",
              "ppt",
              "json",
              "other"
            ]
          },
          "original_type": {
            "type": "string",
            "minLength": 1
          },
          "canonical_uri": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "captured_at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "coverage": {
            "type": "string",
            "enum": [
              "full",
              "article_text",
              "partial"
            ]
          },
          "capture_method": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "source_class",
          "type",
          "original_type",
          "canonical_uri",
          "publisher",
          "published_at",
          "captured_at",
          "file",
          "sha256",
          "coverage",
          "capture_method"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "claim",
              "hypothesis"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "rejected"
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewed_at": {
                    "type": "string",
                    "minLength": 1,
                    "format": "date-time"
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "reviewer",
                  "reviewed_at",
                  "method"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "source_id",
          "kind",
          "claim",
          "excerpt",
          "locator",
          "status",
          "review"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "frequency": {
            "type": "string",
            "enum": [
              "annual",
              "monthly",
              "cumulative",
              "point_in_time"
            ]
          },
          "geography": {
            "type": "string",
            "minLength": 1
          },
          "methodology": {
            "type": "string",
            "minLength": 1
          },
          "period_start": {
            "type": "string",
            "minLength": 1,
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "minLength": 1,
            "format": "date"
          },
          "value": {
            "type": "number"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "value_text": {
            "type": "string",
            "minLength": 1
          },
          "value_transform": {
            "type": "string",
            "enum": [
              "identity",
              "negate"
            ]
          },
          "shared_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "required": [
          "id",
          "name",
          "unit",
          "frequency",
          "geography",
          "methodology",
          "period_start",
          "period_end",
          "value",
          "evidence_id",
          "value_text",
          "value_transform"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "analysis": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "mode": {
          "type": "string",
          "enum": [
            "historical_reconstruction",
            "current_research"
          ]
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "minItems": 1
              },
              "metric_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "minItems": 0
              },
              "reversal_conditions": {
                "type": "string",
                "minLength": 1
              },
              "shared_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            },
            "required": [
              "id",
              "name",
              "mechanism",
              "direction",
              "confidence",
              "evidence_ids",
              "metric_ids",
              "reversal_conditions"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "base",
                  "upside",
                  "stress"
                ]
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "signals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "falsifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "factor_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "assumptions",
              "signals",
              "falsifiers",
              "factor_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "next_review_date": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "causal_edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "from_factor_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "sign": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "conditional"
                ]
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "lag": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "minItems": 1
              },
              "falsifier": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "hypothesis"
                ]
              }
            },
            "required": [
              "id",
              "from_factor_id",
              "outcome",
              "sign",
              "mechanism",
              "lag",
              "scope",
              "evidence_ids",
              "falsifier",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question",
        "as_of_date",
        "mode",
        "factors",
        "scenarios",
        "limitations",
        "next_review_date",
        "causal_edges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "topic",
    "created_at",
    "producer",
    "sources",
    "evidence",
    "metrics",
    "analysis"
  ],
  "additionalProperties": false
}
